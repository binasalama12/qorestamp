# QoreStamp endpoints — QoreChain testnet "qorechain-diana" (EVM chain id 9800).
# The public REST API sends no CORS headers, so the browser reaches it through
# the Vite dev server: requests to /lcd go to QORE_REST_PROXY_TARGET.
VITE_QORE_REST_URL=/lcd
QORE_REST_PROXY_TARGET=https://api-testnet.qore.host
VITE_QORE_EVM_RPC_URL=https://evm-testnet.qore.host

# Native (Cosmos) RPC — used by the verification helpers for tx lookups.
VITE_QORE_RPC_URL=https://rpc-testnet.qore.host

# Address of the deployed QoreStampRegistry contract on diana (set after deploy).
VITE_QORESTAMP_REGISTRY=

# --- deploy-registry.ts only (server-side, never expose to the browser) ---
QORE_EVM_RPC_URL=https://evm-testnet.qore.host
# A funded EVM account's private key (0x-prefixed, 32 bytes). DO NOT commit a real key.
QORE_EVM_PRIVATE_KEY=
